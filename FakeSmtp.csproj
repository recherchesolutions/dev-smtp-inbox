<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FakeSmtp</RootNamespace>
    <AssemblyName>FakeSmtp</AssemblyName>
    <!-- Install, mail and log folders live next to the project; keep them out of the build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;mail/**;logs/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
    <PackageReference Include="MimeKit" Version="4.18.2" />
  </ItemGroup>

</Project>
